# EnterLMS — Inertia + Laravel public/
# Installed as /etc/caddy/sites/lms.pamungkas.org.caddy

__DOMAIN__ {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	root * __APP_DIR__/public

	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi unix/__PHP_SOCK__ {
		dial_timeout 5s
		read_timeout 120s
	}

	file_server
}
